# Email delivery (MXroute SMTP)
# Add these in Vercel → Project → Settings → Environment Variables
# (Production + Preview), then Redeploy.
#
# CRITICAL: SMTP_USER must NOT be the same as MAIL_TO.
# If both are info@, MXroute often accepts the send but never shows it
# in the Inbox (it may only appear under Sent).
# Use admin@ (or another mailbox) to send INTO info@.

SMTP_HOST=wednesday.mxrouting.net
SMTP_PORT=587
SMTP_USER=admin@ardnabta.com
SMTP_PASS=password-for-admin-mailbox
MAIL_TO=info@ardnabta.com

# Optional. Address shown as NO REPLY on auto-replies.
# Defaults to SMTP_USER if omitted.
# SMTP_NOREPLY=admin@ardnabta.com
