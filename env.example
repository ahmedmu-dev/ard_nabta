# Email delivery (MXroute SMTP)
# Add these in Vercel → Project → Settings → Environment Variables
# (Production), then redeploy.

SMTP_HOST=wednesday.mxrouting.net
SMTP_PORT=587
SMTP_USER=info@ardnabta.com
SMTP_PASS=your-info-mailbox-password

# Optional. Address used for auto-replies that show as "NO REPLY".
# Defaults to SMTP_USER / info@ardnabta.com if omitted.
# SMTP_NOREPLY=noreply@ardnabta.com
